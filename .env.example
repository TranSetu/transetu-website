# Transetu Website SMTP Configuration (Gmail)
# Copy this file to .env.local and fill in your actual credentials.
# Note: .env* files containing credentials are git-ignored and should NEVER be committed.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
